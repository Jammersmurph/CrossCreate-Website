---
import Icon from './Icon.astro';
import { features, specs } from '../data/site';
---

<section class="section" id="machine">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow"><span class="eyebrow-bracket">[</span> 01 / The machine <span class="eyebrow-bracket">]</span></p>
        <h2>Built from brass,<br />stress &amp; stubborn ideas.</h2>
      </div>
      <p class="section-lede">
        For the tinkerers. The architects. The “what if we built this?” people.
        There’s a bench for your next big idea here.
      </p>
    </div>

    <div class="machines">
      {features.map((feature) => (
        <article class="machine">
          <span class="rivet rivet-tl" aria-hidden="true"></span>
          <span class="rivet rivet-tr" aria-hidden="true"></span>
          <span class="rivet rivet-bl" aria-hidden="true"></span>
          <span class="rivet rivet-br" aria-hidden="true"></span>

          <div class="machine-top">
            <span class="machine-index">Module {feature.index}</span>
            <span class="machine-slot"><Icon name={feature.icon} /></span>
          </div>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
          <p class="machine-tag">{feature.tag}</p>
        </article>
      ))}
    </div>

    <dl class="specs">
      {specs.map((spec) => (
        <div class="spec">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
