---
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <a class="footer-brand" href="/" aria-label={`${site.name} — home`}>
      <img src={site.logo.src} alt="" width="30" height="30" />
      {site.logo.wordmark && <span>CROSS<b>CREATE</b></span>}
    </a>

    <p class="footer-legal">
      An independent Minecraft community.<br />
      Not affiliated with Mojang, Microsoft, or the Create team.
    </p>

    <nav class="footer-links" aria-label="Footer">
      <a href={site.repository} target="_blank" rel="noopener noreferrer">Source <span aria-hidden="true">↗</span></a>
      <a href="#join">Assembly</a>
      <a href="#notes">Notes</a>
    </nav>

    <p class="footer-meta"><span>© 2026 {site.name}</span><span>CC-26/JB</span></p>
  </div>
</footer>
