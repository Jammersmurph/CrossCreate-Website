---
interface Props {
  name: 'gear' | 'link' | 'world' | 'copy' | 'arrow' | 'signal' | 'chevron';
  class?: string;
}

const { name, class: className = 'icon' } = Astro.props;
const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.6',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const;
---

<svg class={className} viewBox="0 0 24 24" {...stroke} aria-hidden="true">
  {name === 'gear' && (
    <>
      <circle cx="12" cy="12" r="3.1" />
      <path d="M10.6 2.4h2.8l.5 2.5 1.3.5 2-1.4 2 2-1.4 2 .5 1.3 2.5.5v2.8l-2.5.5-.5 1.3 1.4 2-2 2-2-1.4-1.3.5-.5 2.5h-2.8l-.5-2.5-1.3-.5-2 1.4-2-2 1.4-2-.5-1.3-2.5-.5V10.4l2.5-.5.5-1.3-1.4-2 2-2 2 1.4 1.3-.5z" />
    </>
  )}
  {name === 'link' && (
    <>
      <path d="M3.5 12h17" />
      <path d="m7.5 8-4 4 4 4" />
      <path d="m16.5 8 4 4-4 4" />
    </>
  )}
  {name === 'world' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3.4 9.5h17.2M3.4 14.5h17.2" />
      <path d="M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" />
    </>
  )}
  {name === 'copy' && (
    <>
      <rect x="9" y="9" width="11" height="11" rx="1.4" />
      <path d="M5.5 15H4.9A1.9 1.9 0 0 1 3 13.1V4.9A1.9 1.9 0 0 1 4.9 3h8.2A1.9 1.9 0 0 1 15 4.9v.6" />
    </>
  )}
  {name === 'arrow' && (
    <>
      <path d="M7 17 17 7" />
      <path d="M8 7h9v9" />
    </>
  )}
  {name === 'signal' && (
    <>
      <path d="M4 14.5a8 8 0 0 1 16 0" />
      <path d="M7.4 14.5a4.6 4.6 0 0 1 9.2 0" />
      <circle cx="12" cy="17.5" r="1.2" fill="currentColor" stroke="none" />
      <path d="M12 4.5V3" />
    </>
  )}
  {name === 'chevron' && <path d="m6 9 6 6 6-6" />}
</svg>
